(* ====================================================================== *)
(* FB300: EINRICHTBETRIEB (HANDBETRIEB)                                   *)
(*                                                                        *)
(* Steuert alle manuellen Aktor-Bewegungen.                               *)
(* Ist nur aktiv, wenn die globale Variable "Einrichtbetrieb" TRUE ist.   *)
(* Liest die Taster (-SJ6 bis -SJ12) und steuert Achsen/Zylinder direkt.  *)
(* MM30/MM40: Einfahren = Selbsthaltung, Ausfahren = Tipp-Betrieb.        *)
(* ====================================================================== *)

FUNCTION_BLOCK FB300 // Einrichtbetrieb (Handbetrieb)


VAR
  // Interne Variablen des FBs
  TIMER_QA61      : TP;  // Timer fuer Magnet-Abschaltung (5s Nachlauf)
END_VAR

BEGIN // Start der FB300-Logik
  
  // --- 0. SCHUTZBEDINGUNG (Guard Clause) ---
  // Prueft, ob der Baustein ueberhaupt aktiv sein soll.
  IF "dbGlobal".Betriebsart.Einrichten THEN
    
    
    // --- HANDBETRIEB AKTIV ---
    
    // -- Steuerung X-Achse (SR-Logik mit Vorrang Reset) --
    
    IF ("-SJ6" AND NOT "-SJ7" AND NOT "-BG11" AND NOT "dbGlobal".Steuer_Hand.QA6_Rechts) THEN
      "dbGlobal".Steuer_Hand._QA5_Links := TRUE;
    ELSIF "-BG11" OR ("-SJ7" AND NOT "-SJ6") THEN 
      "dbGlobal".Steuer_Hand._QA5_Links := FALSE;
    END_IF;
    IF ("-SJ7" AND NOT "-SJ6" AND NOT "-BG13" AND NOT "dbGlobal".Steuer_Hand._QA5_Links) THEN
      "dbGlobal".Steuer_Hand.QA6_Rechts := TRUE;
    ELSIF "-BG13" OR ("-SJ6" AND NOT "-SJ7") THEN
      "dbGlobal".Steuer_Hand.QA6_Rechts := FALSE;
    END_IF;
    
    // -- Steuerung Zylinder MM20 (Magazin) (SR-Logik) --
    IF ("-SJ8" AND NOT "-SJ9" AND NOT "-BG21") THEN // Einfahren
      "dbGlobal".Steuer_Hand.MB21_Ein := TRUE;
    ELSIF "-BG21" OR ("-SJ9" AND NOT "-SJ8") THEN
      "dbGlobal".Steuer_Hand.MB21_Ein := FALSE;
    END_IF;
    IF ("-SJ9" AND NOT "-SJ8" AND NOT "-BG22") THEN // Ausfahren
      "dbGlobal".Steuer_Hand.MB22_Aus := TRUE;
    ELSIF "-BG22" OR ("-SJ8" AND NOT "-SJ9") THEN
      "dbGlobal".Steuer_Hand.MB22_Aus := FALSE;
    END_IF;
    
    // -- Steuerung Zylinder MM30 (Wippe) (Selbsthaltung) --
    IF (NOT "-SJ10") THEN // Taster nach unten -> Einfahren
      "dbGlobal".Steuer_Hand.MB31_Ein := TRUE;
    ELSIF "-BG31" THEN // Endlage erreicht -> Ruecksetzen
      "dbGlobal".Steuer_Hand.MB31_Ein := FALSE;
    END_IF;
    IF ("-SJ10" AND NOT "-BG32") THEN // Taster nach oben -> Ausfahren
      "dbGlobal".Steuer_Hand.MB32_Aus := TRUE;
    ELSIF "-BG32" OR (NOT "-SJ10") THEN // Endlage ODER Taster losgelassen
      "dbGlobal".Steuer_Hand.MB32_Aus := FALSE;
    END_IF;

    // -- Steuerung Zylinder MM40 (Magnet) (Selbsthaltung) --
    IF (NOT "-SJ11") THEN // Taster nach unten -> Einfahren
      "dbGlobal".Steuer_Hand.MB41_Ein := TRUE;
    ELSIF "-BG41" THEN // Endlage erreicht -> Ruecksetzen
      "dbGlobal".Steuer_Hand.MB41_Ein := FALSE;
    END_IF;
    IF ("-SJ11" AND NOT "-BG42") THEN // Taster nach oben -> Ausfahren
      "dbGlobal".Steuer_Hand.MB42_Aus := TRUE;
    ELSIF "-BG42" OR (NOT "-SJ11") THEN // Endlage ODER Taster losgelassen
      "dbGlobal".Steuer_Hand.MB42_Aus := FALSE;
    END_IF;

    // -- Steuerung Magnet-Schuetz QA61 (mit TP-Timer) --
    // Magnet ist aus, wenn SJ12 gedrueckt wird.
    // Wenn SJ12 losgelassen wird, bleibt er noch 5s aus.
    TIMER_QA61(IN := "-SJ12", PT := T#5s);
    "dbGlobal".Steuer_Hand.QA61_Magnet := TIMER_QA61.Q;

  ELSE
    // --- BAUSTEIN NICHT AKTIV ---
    // Alle Ausgaenge zuruecksetzen, wenn Einrichtbetrieb beendet wird.
      "dbGlobal".Steuer_Hand.MB21_Ein    := FALSE;
      "dbGlobal".Steuer_Hand.MB22_Aus    := FALSE;
      "dbGlobal".Steuer_Hand.MB31_Ein    := FALSE;
      "dbGlobal".Steuer_Hand.MB32_Aus    := FALSE;
      "dbGlobal".Steuer_Hand.MB41_Ein    := FALSE;
      "dbGlobal".Steuer_Hand.MB42_Aus    := FALSE;
      "dbGlobal".Steuer_Hand.QA5_Links   := FALSE;
      "dbGlobal".Steuer_Hand.QA6_Rechts  := FALSE;
      "dbGlobal".Steuer_Hand.QA61_Magnet := FALSE; // Standard: Magnet AN (siehe Timer-Logik)

    // Timer ebenfalls zuruecksetzen
    TIMER_QA61(IN := FALSE);

    // Bearbeitung beenden
    RETURN;
  END_IF;

END_FUNCTION_BLOCK
