ORGANIZATION_BLOCK "Zyklus"
TITLE = Zyklus
// Autor: Boris Quade
// Datum: 23.10.2025
// 
// Dieser OB1 ruft alle notwendigen FBs
// fuer die Sortieranlage auf.
VERSION : 1.0


VAR_TEMP
  OB1_Reserve_Bytes : ARRAY  [1 .. 20 ] OF BYTE ;	// 20 Bytes Dummy-Daten
END_VAR

BEGIN
  NETWORK
    TITLE = "Betriebsarten und Takt"
    CALL FB 0, DB 0   // Betriebsartenwahl (Schreibt in dbGlobal.Betriebsart)
    CALL FB 100, DB 100 // Taktgeber (Schreibt in dbGlobal.Takt_1Hz)

  NETWORK
    TITLE = "Steuerlogik (Hand / Automatik)"
    CALL FB 300, DB 300 // Einrichtbetrieb (Schreibt in dbGlobal.Steuer_Hand)
    CALL FB 500, DB 500 // Automatik (Schreibt in dbGlobal.Steuer_Auto)

  NETWORK
    TITLE = "Aktionen und Verriegelung"
    CALL FB 600, DB 600 // Aktionen (Liest Steuer_Hand/Auto, Schreibt Steuer_Final & Ausgaenge)
    
  NETWORK
    TITLE = "Sensorik und Anzeige"
    CALL FB 1, DB 1     // Positionserfassung (Liest dbGlobal.Steuer_Final)
    CALL FB 200, DB 200 // Meldeleuchten (Liest dbGlobal)

END_ORGANIZATION_BLOCK
END_ORGANIZATION_BLOCK

