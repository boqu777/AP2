(* ====================================================================== *)
(* FB1: POSITIONSERFASSUNG                                                *)
(*                                                                        *)
(* Verwaltet den globalen Positionszaehler (Variable "Position", MW8).    *)
(* Zaehlt hoch/runter basierend auf dem Inkrementalgeber -BG12 und der    *)
(* aktiven Fahrtrichtung (sig_QA5 = Linksfahrt / sig_QA6 = Rechtsfahrt).  *)
(* Setzt den Zaehler bei Erreichen des Referenzschalters -BG13 auf 0.     *)
(* ====================================================================== *)
FUNCTION_BLOCK FB1 // FB_Positionierung (Globaler Zaehler)

VAR // Interner Speicher des FBs
  BG12_ALT : BOOL;
END_VAR

VAR_TEMP
  BG12_FLANKE : BOOL;
END_VAR

BEGIN

// Bei Linksfahrt (aus Steuer_Final) hochzaehlen
    // Wir lesen das Signal, das TATSÄCHLICH zum Motor geht
    IF "dbGlobal".Steuer_Final.QA5_Links THEN 
      IF "dbGlobal".Achse_X.IstPosition < 999 THEN
        "dbGlobal".Achse_X.IstPosition := "dbGlobal".Achse_X.IstPosition + 1;
      END_IF;
      
    // Bei Rechtsfahrt (aus Steuer_Final) runterzaehlen
    ELSIF "dbGlobal".Steuer_Final.QA6_Rechts THEN 
      IF "dbGlobal".Achse_X.IstPosition > 0 THEN
        "dbGlobal".Achse_X.IstPosition := "dbGlobal".Achse_X.IstPosition - 1;
      END_IF;
    END_IF;
  END_IF; 

  // --- 3. Referenzieren (Grundposition) ---
  // Wenn der Referenzschalter BG13 betaetigt wird, Position auf 0 setzen.
  IF "-BG13" THEN
    "dbGlobal".Achse_X.IstPosition := 0;
  END_IF;

END_FUNCTION_BLOCK
