(* ====================================================================== *)
(* FB900: DIAGNOSE UND TESTFUNKTIONEN                                    *)
(*                                                                        *)
(* Zweck:                                                                 *)
(* - Ueberwachung der Zykluszeit und Performance                          *)
(* - Plausibilitaetspruefung aller Sensoren                               *)
(* - Protokollierung von Ereignissen und Fehlern                          *)
(* - Testmodi fuer Inbetriebnahme und Wartung                             *)
(*                                                                        *)
(* Autor: Boris Quade                                                      *)
(* Datum: 01.11.2025                                                      *)
(* Version: 1.0                                                           *)
(* CPU: S7-300 CPU 314C-2PN/DP, STEP7 v5.6 SP1                            *)
(* ====================================================================== *)

FUNCTION_BLOCK FB900
TITLE = 'Diagnose und Testfunktionen'

(* ====================================================================== *)
(* VAR_INPUT: Eingaenge des Funktionsbausteins                            *)
(* ====================================================================== *)
VAR_INPUT
  // Steuerung der Testmodi
  Test_Aktiv          : BOOL := FALSE;  // Master-Schalter fuer alle Tests
  Test_Zyklus         : BOOL := FALSE;  // Zykluszeit-Ueberwachung aktiv
  Test_Sensoren       : BOOL := FALSE;  // Sensor-Plausibilitaet pruefen
  Test_Logbuch        : BOOL := FALSE;  // Ereignis-Protokollierung aktiv
  Test_Simulation     : BOOL := FALSE;  // Simulations-Modus (ohne Hardware)
  
  // Referenzen auf globale Systemvariablen
  Einrichtbetrieb     : BOOL;           // Aktueller Betriebsmodus
  Automatikbetrieb    : BOOL;
  Schritt_Automatik   : INT;            // Aktueller Schritt aus FB500
  Position            : INT;            // IST-Position X-Achse
END_VAR

(* ====================================================================== *)
(* VAR_OUTPUT: Ausgaenge fuer andere Bausteine                            *)
(* ====================================================================== *)
VAR_OUTPUT
  // Status-Informationen
  Diagnose_OK         : BOOL := TRUE;   // FALSE bei erkannten Fehlern
  Warnung_Aktiv       : BOOL := FALSE;  // TRUE bei Plausibilitaets-Warnung
  
  // Fehler-Codes (0 = kein Fehler)
  Fehlercode          : INT := 0;       // Haupt-Fehlercode
  Fehler_Detail       : INT := 0;       // Detail-Information zum Fehler
  
  // Performance-Daten
  Zykluszeit_Aktuell  : INT := 0;       // Aktuelle Zykluszeit in ms
  Zykluszeit_Max      : INT := 0;       // Maximale Zykluszeit seit Reset
  Zykluszeit_Min      : INT := 999;     // Minimale Zykluszeit seit Reset
  Zyklen_Gesamt       : DINT := 0;      // Gesamtzahl der Zyklen
  
  // Betriebsstunden-Zaehler
  Betriebsstunden     : DINT := 0;      // Gesamt-Betriebszeit in Sekunden
  Zyklen_Automatik    : DINT := 0;      // Anzahl abgeschlossener Zyklen
  
  // Sensor-Status (Bitfeld)
  Sensoren_Fehler     : WORD := 16#0000; // Bit = 1 bei Sensor-Fehler
END_VAR

(* ====================================================================== *)
(* VAR: Interne statische Variablen (behalten Wert zwischen Zyklen)       *)
(* ====================================================================== *)
VAR
  // --- Zykluszeit-Messung ---
  Zeit_Start          : TIME;           // Startzeit des aktuellen Zyklus
  Zeit_Ende           : TIME;           // Endzeit des aktuellen Zyklus
  Zeit_Differenz      : TIME;           // Berechnete Zykluszeit
  
  // --- Betriebsstunden-Zaehler ---
  Timer_Sekunde       : TON;            // 1-Sekunden-Timer
  
  // --- Sensor-Ueberwachung ---
  Sensor_Timeout      : ARRAY[1..10] OF TON;  // Timeout-Timer pro Sensor
  Sensor_Letzter_Wert : ARRAY[1..10] OF BOOL; // Vorheriger Sensor-Zustand
  Sensor_Wechsel_Zeit : ARRAY[1..10] OF TIME; // Zeit seit letztem Wechsel
  
  // --- Logbuch (Ring-Puffer) ---
  Logbuch_Index       : INT := 0;       // Aktueller Schreibindex (0-99)
  Logbuch_Zeitstempel : ARRAY[0..99] OF TIME;  // Ereignis-Zeitstempel
  Logbuch_Ereignis    : ARRAY[0..99] OF INT;   // Ereignis-Code
  Logbuch_Wert1       : ARRAY[0..99] OF INT;   // Zusatzinfo 1
  Logbuch_Wert2       : ARRAY[0..99] OF INT;   // Zusatzinfo 2
  
  // --- Schritt-Ueberwachung Automatik ---
  Schritt_ALT         : INT := 500;     // Vorheriger Schritt
  Schritt_Timeout     : TON;            // Max. Zeit pro Schritt
  Schritt_Startzeit   : TIME;           // Schritt-Beginn
  
  // --- Initialisierung ---
  Erstlauf            : BOOL := TRUE;   // TRUE nur beim ersten Aufruf
  
END_VAR

(* ====================================================================== *)
(* VAR_TEMP: Temporaere Variablen (werden jeden Zyklus neu initialisiert) *)
(* ====================================================================== *)
VAR_TEMP
  i                   : INT;            // Schleifen-Zaehler
  Sensor_Aktuell      : BOOL;           // Temp. Variable fuer Sensor-Wert
  Zeit_Temp           : TIME;           // Temp. Variable fuer Zeitberechnungen
END_VAR

(* ====================================================================== *)
(* PROGRAMM-CODE                                                          *)
(* ====================================================================== *)
BEGIN

  (* ==================================================================== *)
  (* 0. INITIALISIERUNG (nur beim ersten Aufruf)                          *)
  (* ==================================================================== *)
  IF Erstlauf THEN
    Erstlauf := FALSE;
    
    // Alle Fehler zuruecksetzen
    Fehlercode := 0;
    Fehler_Detail := 0;
    Diagnose_OK := TRUE;
    Warnung_Aktiv := FALSE;
    
    // Performance-Zaehler zuruecksetzen
    Zykluszeit_Max := 0;
    Zykluszeit_Min := 999;
    Zyklen_Gesamt := 0;
    
    // Logbuch loeschen
    FOR i := 0 TO 99 DO
      Logbuch_Zeitstempel[i] := T#0ms;
      Logbuch_Ereignis[i] := 0;
      Logbuch_Wert1[i] := 0;
      Logbuch_Wert2[i] := 0;
    END_FOR;
    
    // Ereignis ins Logbuch schreiben
    IF Test_Logbuch THEN
      Logbuch_Ereignis[0] := 1000;  // Code 1000 = System-Start
    END_IF;
    
  END_IF;
  
  (* ==================================================================== *)
  (* 1. MASTER-SCHALTER PRUEFEN                                           *)
  (* ==================================================================== *)
  // Wenn Test_Aktiv = FALSE, wird nur der Minimalcode ausgefuehrt
  IF NOT Test_Aktiv THEN
    Diagnose_OK := TRUE;
    Warnung_Aktiv := FALSE;
    RETURN;  // Baustein beenden
  END_IF;
  
  (* ==================================================================== *)
  (* 2. ZYKLUSZEIT-MESSUNG                                                *)
  (* ==================================================================== *)
  IF Test_Zyklus THEN
    
    // Startzeit erfassen (erster Aufruf im Zyklus)
    Zeit_Start := TIME();  // Systemzeit in ms seit CPU-Start
    
    // Differenz zum letzten Zyklus berechnen
    IF Zeit_Ende > T#0ms THEN
      Zeit_Differenz := Zeit_Start - Zeit_Ende;
      Zykluszeit_Aktuell := TIME_TO_INT(Zeit_Differenz);  // In ms
      
      // Min/Max aktualisieren
      IF Zykluszeit_Aktuell > Zykluszeit_Max THEN
        Zykluszeit_Max := Zykluszeit_Aktuell;
      END_IF;
      
      IF Zykluszeit_Aktuell < Zykluszeit_Min AND Zykluszeit_Aktuell > 0 THEN
        Zykluszeit_Min := Zykluszeit_Aktuell;
      END_IF;
      
      // Warnung bei Ueberschreitung der Soll-Zykluszeit (z.B. 100ms)
      IF Zykluszeit_Aktuell > 100 THEN
        Warnung_Aktiv := TRUE;
        Fehlercode := 901;  // Code 901 = Zykluszeit zu hoch
        Fehler_Detail := Zykluszeit_Aktuell;
      END_IF;
      
    END_IF;
    
    // Endzeit fuer naechsten Zyklus speichern
    Zeit_Ende := Zeit_Start;
    
    // Zyklen-Zaehler erhoehen
    IF Zyklen_Gesamt < 2147483647 THEN  // Max. DINT
      Zyklen_Gesamt := Zyklen_Gesamt + 1;
    END_IF;
    
  END_IF;
  
  (* ==================================================================== *)
  (* 3. BETRIEBSSTUNDEN-ZAEHLER                                           *)
  (* ==================================================================== *)
  IF Test_Aktiv THEN
    
    // 1-Sekunden-Timer
    Timer_Sekunde(IN := TRUE, PT := T#1s);
    
    IF Timer_Sekunde.Q THEN
      Timer_Sekunde(IN := FALSE);  // Timer zuruecksetzen
      
      // Betriebsstunden erhoehen (nur wenn eine Betriebsart aktiv)
      IF Einrichtbetrieb OR Automatikbetrieb THEN
        IF Betriebsstunden < 2147483647 THEN
          Betriebsstunden := Betriebsstunden + 1;
        END_IF;
      END_IF;
      
    END_IF;
    
  END_IF;
  
  (* ==================================================================== *)
  (* 4. SENSOR-PLAUSIBILITAETS-PRUEFUNG                                   *)
  (* ==================================================================== *)
  IF Test_Sensoren THEN
    
    // Sensor-Array initialisieren (Zuordnung siehe unten)
    // 1=BG11, 2=BG12, 3=BG13, 4=BG21, 5=BG22, 6=BG31, 7=BG32, 8=BG41, 9=BG42, 10=BP1
    
    // --- Test 1: Gegenseitige Ausschluesse (darf nicht gleichzeitig TRUE sein) ---
    
    // BG21 (ein) und BG22 (aus) von MM20
    IF "-BG21" AND "-BG22" THEN
      Sensoren_Fehler := Sensoren_Fehler OR 16#0001;  // Bit 0
      Fehlercode := 910;
      Fehler_Detail := 20;  // MM20
    END_IF;
    
    // BG31 (ein) und BG32 (aus) von MM30
    IF "-BG31" AND "-BG32" THEN
      Sensoren_Fehler := Sensoren_Fehler OR 16#0002;  // Bit 1
      Fehlercode := 910;
      Fehler_Detail := 30;  // MM30
    END_IF;
    
    // BG41 (ein) und BG42 (aus) von MM40
    IF "-BG41" AND "-BG42" THEN
      Sensoren_Fehler := Sensoren_Fehler OR 16#0004;  // Bit 2
      Fehlercode := 910;
      Fehler_Detail := 40;  // MM40
    END_IF;
    
    // BG11 (links) und BG13 (rechts) von X-Achse
    IF "-BG11" AND "-BG13" THEN
      Sensoren_Fehler := Sensoren_Fehler OR 16#0008;  // Bit 3
      Fehlercode := 910;
      Fehler_Detail := 10;  // X-Achse
    END_IF;
    
    // --- Test 2: Materialerkennung Plausibilitaet ---
    // BG51 (Metall) und BG52 (Bohrung): 
    // Wenn BG52=TRUE (Bohrung erkannt), muss auch BG51=TRUE (Material da) sein
    IF "-BG52" AND NOT "-BG51" THEN
      Sensoren_Fehler := Sensoren_Fehler OR 16#0010;  // Bit 4
      Fehlercode := 911;
      Fehler_Detail := 52;  // BG52 ohne BG51
    END_IF;
    
    // --- Test 3: Timeout-Ueberwachung fuer bewegte Zylinder ---
    // Wenn Befehl zum Ausfahren gegeben wurde, muss binnen 5s Endlage erreicht sein
    
    // MM20: Timeout bei Ausfahren (nur wenn sig_MB22 aktiv)
    IF "sig_MB22" AND NOT "-BG22" THEN
      Sensor_Timeout[5](IN := TRUE, PT := T#5s);
      IF Sensor_Timeout[5].Q THEN
        Sensoren_Fehler := Sensoren_Fehler OR 16#0020;  // Bit 5
        Fehlercode := 920;
        Fehler_Detail := 22;  // MM20 Timeout beim Ausfahren
      END_IF;
    ELSE
      Sensor_Timeout[5](IN := FALSE);
    END_IF;
    
    // MM20: Timeout bei Einfahren
    IF "sig_MB21" AND NOT "-BG21" THEN
      Sensor_Timeout[4](IN := TRUE, PT := T#5s);
      IF Sensor_Timeout[4].Q THEN
        Sensoren_Fehler := Sensoren_Fehler OR 16#0040;  // Bit 6
        Fehlercode := 920;
        Fehler_Detail := 21;  // MM20 Timeout beim Einfahren
      END_IF;
    ELSE
      Sensor_Timeout[4](IN := FALSE);
    END_IF;
    
    // Aehnlich fuer MM30, MM40, X-Achse (hier verkuerzt)
    
    // --- Test 4: Betriebsdruck-Ueberwachung ---
    IF NOT "-BP1" AND (Einrichtbetrieb OR Automatikbetrieb) THEN
      Sensoren_Fehler := Sensoren_Fehler OR 16#0080;  // Bit 7
      Fehlercode := 930;
      Fehler_Detail := 1;  // Druckverlust waehrend Betrieb
    END_IF;
    
    // Fehler-Flag setzen, wenn Sensoren_Fehler <> 0
    IF Sensoren_Fehler <> 16#0000 THEN
      Diagnose_OK := FALSE;
      Warnung_Aktiv := TRUE;
    ELSE
      Diagnose_OK := TRUE;
      Warnung_Aktiv := FALSE;
      Fehlercode := 0;
      Fehler_Detail := 0;
    END_IF;
    
  END_IF;
  
  (* ==================================================================== *)
  (* 5. SCHRITT-UEBERWACHUNG IM AUTOMATIKBETRIEB                          *)
  (* ==================================================================== *)
  IF Test_Aktiv AND Automatikbetrieb THEN
    
    // Schrittwechsel erkennen
    IF Schritt_Automatik <> Schritt_ALT THEN
      
      // Ereignis ins Logbuch schreiben
      IF Test_Logbuch THEN
        Logbuch_Index := Logbuch_Index + 1;
        IF Logbuch_Index > 99 THEN
          Logbuch_Index := 0;  // Ring-Puffer
        END_IF;
        
        Logbuch_Zeitstempel[Logbuch_Index] := TIME();
        Logbuch_Ereignis[Logbuch_Index] := 2000;  // Code 2000 = Schrittwechsel
        Logbuch_Wert1[Logbuch_Index] := Schritt_ALT;
        Logbuch_Wert2[Logbuch_Index] := Schritt_Automatik;
      END_IF;
      
      // Timeout-Timer neu starten
      Schritt_Startzeit := TIME();
      Schritt_Timeout(IN := FALSE);
      
      Schritt_ALT := Schritt_Automatik;
    END_IF;
    
    // Timeout-Ueberwachung pro Schritt (max. 30s)
    Schritt_Timeout(IN := TRUE, PT := T#30s);
    
    IF Schritt_Timeout.Q THEN
      Fehlercode := 940;  // Code 940 = Schritt-Timeout
      Fehler_Detail := Schritt_Automatik;
      Diagnose_OK := FALSE;
      
      // Ins Logbuch schreiben
      IF Test_Logbuch THEN
        Logbuch_Index := Logbuch_Index + 1;
        IF Logbuch_Index > 99 THEN
          Logbuch_Index := 0;
        END_IF;
        
        Logbuch_Zeitstempel[Logbuch_Index] := TIME();
        Logbuch_Ereignis[Logbuch_Index] := 9040;  // Code 9040 = Fehler Timeout
        Logbuch_Wert1[Logbuch_Index] := Schritt_Automatik;
        Logbuch_Wert2[Logbuch_Index] := 0;
      END_IF;
      
      // Timer zuruecksetzen, um Fehler-Flut zu vermeiden
      Schritt_Timeout(IN := FALSE);
    END_IF;
    
    // Zyklen-Zaehler erhoehen bei Rueckkehr zu Schritt 500
    IF Schritt_Automatik = 500 AND Schritt_ALT <> 500 THEN
      IF Zyklen_Automatik < 2147483647 THEN
        Zyklen_Automatik := Zyklen_Automatik + 1;
      END_IF;
    END_IF;
    
  END_IF;
  
  (* ==================================================================== *)
  (* 6. SIMULATIONS-MODUS (fuer Test ohne Hardware)                       *)
  (* ==================================================================== *)
  IF Test_Simulation THEN
    
    // ACHTUNG: Dieser Modus ueberschreibt Hardware-Eingaenge!
    // Nur fuer Inbetriebnahme-Tests verwenden!
    
    // Beispiel: Alle Sensoren in Grundstellung simulieren
    // "-BG13" := TRUE;   // X-Achse rechts (NICHT in S7-SCL moeglich!)
    // "-BG21" := TRUE;   // MM20 eingefahren
    // "-BG31" := TRUE;   // MM30 eingefahren
    // "-BG41" := TRUE;   // MM40 eingefahren
    // "-BP1"  := TRUE;   // Druck OK
    
    // HINWEIS: Direkte Eingangszuweisung ist in SCL nicht moeglich.
    // Stattdessen muessen Sie einen Simulations-DB verwenden und
    // die FB0/FB300/FB500 entsprechend anpassen.
    
    // Logbuch-Eintrag
    IF Test_Logbuch AND Erstlauf THEN
      Logbuch_Ereignis[1] := 8000;  // Code 8000 = Simulations-Modus aktiv
    END_IF;
    
  END_IF;
  
  (* ==================================================================== *)
  (* 7. LOGBUCH-VERWALTUNG                                                *)
  (* ==================================================================== *)
  // Das Logbuch wird automatisch in den obigen Abschnitten befuellt.
  // Hier koennte zusaetzliche Logik fuer Logbuch-Export stehen.
  
  (* ==================================================================== *)
  (* 8. FEHLERCODE-DOKUMENTATION (nur Kommentar)                          *)
  (* ==================================================================== *)
  // Code-Bereich | Bedeutung
  // -------------|------------------------------------------------------
  // 0            | Kein Fehler
  // 900-909      | Zykluszeit-Fehler (901 = Zykluszeit zu hoch)
  // 910-919      | Sensor-Plausibilitaet (910 = Ausschluss verletzt)
  // 920-929      | Sensor-Timeout (920 = Zylinder-Timeout)
  // 930-939      | Betriebsdruck (930 = Druckverlust)
  // 940-949      | Schritt-Timeout (940 = Schritt haengt)
  // 1000         | System-Start
  // 2000         | Schrittwechsel (normal)
  // 8000         | Simulations-Modus aktiv
  // 9xxx         | Kritische Fehler (z.B. 9040 = Timeout-Fehler)
  
END_FUNCTION_BLOCK