(*======================================================================= *)
(* FC10: RESET AKTORIK                                                    *)
(* ====================================================================== *)
(* Beschreibung:                                                          *)
(* Setzt alle Aktor-Signal-Merker auf FALSE, wenn KEINE der               *)
(* Haupt-Betriebsarten (Einrichtung ODER Automatik) aktiv ist.            *)
(* Dies stellt einen sicheren Grundzustand für die Aktorik her.           *)
(*                                                                        *)
(* Verwendete globale Variablen (Lesen):                                  *)
(* "Einrichtbetrieb"  (M 1.1)                                             *)
(* "Automatikbetrieb" (M 1.2)                                             *)
(*                                                                        *)
(* Verwendete globale Variablen (Schreiben):                              *)
(* Alle "sig_..." Merker (M0.0 - M1.0)                                    *)
(* ====================================================================== *)
FUNCTION FC10 : VOID
TITLE = 'Reset Aktorik'

BEGIN

    // --- 1. Pruefen, ob alle Betriebsarten AUS sind ---
    // (Liest M 1.1 und M 1.2)
    
    IF (NOT "Einrichtbetrieb") AND (NOT "Automatikbetrieb") THEN
        
        // --- 2. Alle Aktor-Signal-Merker sicher zuruecksetzen ---
        // (VKE = TRUE, da beide Betriebsarten FALSCH sind)
        
      "dbGlobal".Steuer_Hand.MB21_Ein    := FALSE;
      "dbGlobal".Steuer_Hand.MB22_Aus    := FALSE;
      "dbGlobal".Steuer_Hand.MB31_Ein    := FALSE;
      "dbGlobal".Steuer_Hand.MB32_Aus    := FALSE;
      "dbGlobal".Steuer_Hand.MB41_Ein    := FALSE;
      "dbGlobal".Steuer_Hand.MB42_Aus    := FALSE;
      "dbGlobal".Steuer_Hand.QA5_Links   := FALSE;
      "dbGlobal".Steuer_Hand.QA6_Rechts  := FALSE;
      "dbGlobal".Steuer_Hand.QA61_Magnet := FALSE;
        
    END_IF;
    
    // Wenn eine Betriebsart aktiv ist (Einrichten ODER Automatik), 
    // wird dieser IF-Block uebersprungen und die Bausteine
    // FB300 / FB500 koennen die Merker wie gewohnt setzen.

END_FUNCTION
